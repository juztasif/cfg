#!/bin/bash
# Arch Linux Aliases 

# General Defaults
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias grep='grep --color=auto'
alias rf='rm -rf'
alias ni='touch'

# General Utilities
alias rr='source ~/.arch_aliases.sh && clear'
alias c='clear'
alias q='exit'
alias nv='nvim'
alias e='nvim'
alias v='vim'
alias h='history'
alias d='date'
alias t='time'
alias cl='clear; ls'

# Package Management - Pacman
pac() {
  case "$1" in
    i) shift; sudo pacman -S "$@" ;;
    up) sudo pacman -Syu ;;
    r) shift; sudo pacman -Rns "$@" ;;
    li) pacman -Q ;;
    sw) shift; pacman -Si "$@" ;;
    *) echo "Unknown pac command: $1" ;;
  esac
}

# Package Management - Yay (AUR)
yay() {
  case "$1" in
    i) shift; yay -S --noconfirm "$@" ;;
    up) yay -Syu --noconfirm ;;
    r) shift; yay -Rns --noconfirm "$@" ;;
    li) yay -Q ;;
    sw) shift; yay -Si "$@" ;;
    *) echo "Unknown yay command: $1" ;;
  esac
}

# Package Management - Quick Commands
alias i='pac i --noconfirm'
alias r='pac r --noconfirm'
alias rc='sudo pacman -Sc --noconfirm && sudo pacman -Rns $(pacman -Qtdq) --noconfirm'
alias up='pac up --noconfirm'

# Navigation
alias home='cd ~'
alias ~='cd ~'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'
alias dn='cd ~/Downloads'
alias dc='cd ~/Documents'
alias pc='cd ~/Pictures'
alias dk='cd ~/Desktop'

# File Editing with Case Statement
ec() {
  case "$1" in
    rc) nvim ~/.zshrc ;;
    al) nvim ~/.arch_aliases ;;
    nv) nvim ~/.config/nvim/init.vim ;;
    tmx) nvim ~/.config/tmux/tmux.conf ;;
    *) echo "    Wrong Input    " ;;
  esac
}

# System Control with Case Statement
sys() {
  case "$1" in
    sl) systemctl suspend && exit ;;
    sd) systemctl poweroff ;;
    rb) systemctl reboot ;;
    lo) pkill -KILL -u "$USER" ;;
    *) echo "Unknown sys command: $1" ;;
  esac
}

